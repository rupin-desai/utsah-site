{"title":"Utsah Events — Full-Service Event Planning | Bardoli, Gujarat","description":"Utsah Events — premium event planning. Weddings, corporate events, and celebrations crafted with passion in Bardoli, Gujarat.","headExtra":"<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n<link href=\"https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;0,700;1,300;1,400;1,600&family=DM+Sans:wght@200;300;400;500;600;700&display=swap\" rel=\"stylesheet\">\n<link rel=\"stylesheet\" href=\"/style.css?v=85\">","html":"\n\n  <a href=\"#main\" class=\"skip-link\">Skip to content</a>\n\n  <!-- LIQUID GLASS DISTORTION FILTER -->\n  <svg width=\"0\" height=\"0\" style=\"position:absolute\" aria-hidden=\"true\">\n    <filter id=\"liquidGlass\" x=\"-30%\" y=\"-30%\" width=\"160%\" height=\"160%\">\n      <feTurbulence type=\"fractalNoise\" baseFrequency=\"0.008\" numOctaves=\"2\" result=\"noise\"/>\n      <feGaussianBlur in=\"noise\" stdDeviation=\"5\" result=\"blurredNoise\"/>\n      <feDisplacementMap in=\"SourceGraphic\" in2=\"blurredNoise\" scale=\"32\" xChannelSelector=\"R\" yChannelSelector=\"G\"/>\n    </filter>\n    <!-- Stat card refraction: baseFrequency = ripple size (lower = bigger sweeping curves), scale = warp depth (lower = flatter, higher = thicker) -->\n    <filter id=\"liquidGlassStat\" x=\"-30%\" y=\"-30%\" width=\"160%\" height=\"160%\">\n      <feTurbulence type=\"fractalNoise\" baseFrequency=\"0.015\" numOctaves=\"3\" seed=\"7\" result=\"noise\"/>\n      <feGaussianBlur in=\"noise\" stdDeviation=\"2\" result=\"softNoise\"/>\n      <feDisplacementMap in=\"SourceGraphic\" in2=\"softNoise\" scale=\"18\" xChannelSelector=\"R\" yChannelSelector=\"G\"/>\n    </filter>\n    <filter id=\"liquidGlassPill\" x=\"-30%\" y=\"-30%\" width=\"160%\" height=\"160%\">\n      <feTurbulence type=\"fractalNoise\" baseFrequency=\"0.015\" numOctaves=\"3\" seed=\"12\" result=\"noise\"/>\n      <feGaussianBlur in=\"noise\" stdDeviation=\"2\" result=\"softNoise\"/>\n      <feDisplacementMap in=\"SourceGraphic\" in2=\"softNoise\" scale=\"18\" xChannelSelector=\"R\" yChannelSelector=\"G\"/>\n    </filter>\n  </svg>\n\n  <!-- FULLSCREEN BACKGROUND VIDEO -->\n  <div class=\"bg-video-wrap\">\n  <video class=\"bg-video\" autoplay muted loop playsinline webkit-playsinline preload=\"auto\">\n    <source src=\"/assets/hero-video-new.mov\" type=\"video/mp4\">\n  </video>\n  </div>\n  <div class=\"bg-video-overlay\"></div>\n\n  <!-- BACKGROUND PARTICLES -->\n  <canvas id=\"particles\" class=\"bg-canvas\" aria-hidden=\"true\"></canvas>\n\n  <!-- RING CURSOR -->\n  <div class=\"ring-cursor\" id=\"ringCursor\" aria-hidden=\"true\">\n    <svg viewBox=\"0 0 100 80\" xmlns=\"http://www.w3.org/2000/svg\">\n      <defs>\n        <linearGradient id=\"gold1\" x1=\"0%\" y1=\"0%\" x2=\"100%\" y2=\"100%\">\n          <stop offset=\"0%\" stop-color=\"#c9a84c\"/>\n          <stop offset=\"50%\" stop-color=\"#b4903e\"/>\n          <stop offset=\"100%\" stop-color=\"#a07830\"/>\n        </linearGradient>\n        <linearGradient id=\"gold2\" x1=\"100%\" y1=\"0%\" x2=\"0%\" y2=\"100%\">\n          <stop offset=\"0%\" stop-color=\"#c9a84c\"/>\n          <stop offset=\"50%\" stop-color=\"#b4903e\"/>\n          <stop offset=\"100%\" stop-color=\"#a07830\"/>\n        </linearGradient>\n      </defs>\n      <!-- Left ring -->\n      <circle cx=\"36\" cy=\"46\" r=\"24\" fill=\"none\" stroke=\"url(#gold1)\" stroke-width=\"4\"/>\n      <!-- Right ring (overlapping) -->\n      <circle cx=\"64\" cy=\"46\" r=\"24\" fill=\"none\" stroke=\"url(#gold2)\" stroke-width=\"4\"/>\n      <!-- Interlocking: redraw the front arc of the right ring over the left -->\n      <path d=\"M 52.5 27 A 24 24 0 0 1 52.5 65\" fill=\"none\" stroke=\"url(#gold2)\" stroke-width=\"4\"/>\n      <!-- Diamond on left ring -->\n      <rect class=\"ring-cursor__diamond\" x=\"30\" y=\"16\" width=\"10\" height=\"10\" rx=\"1\" fill=\"none\" stroke=\"#c0c0c0\" stroke-width=\"1.5\" opacity=\"0.8\"/>\n    </svg>\n  </div>\n\n  <!-- DECORATIVE FLOATING RINGS -->\n  <div class=\"rings-decor\" id=\"ringsDecor\" aria-hidden=\"true\">\n    <svg viewBox=\"0 0 140 100\" xmlns=\"http://www.w3.org/2000/svg\">\n      <defs>\n        <linearGradient id=\"goldD1\" x1=\"0%\" y1=\"0%\" x2=\"100%\" y2=\"100%\">\n          <stop offset=\"0%\" stop-color=\"#c9a84c\" stop-opacity=\"0.6\"/>\n          <stop offset=\"100%\" stop-color=\"#a07830\" stop-opacity=\"0.3\"/>\n        </linearGradient>\n        <linearGradient id=\"goldD2\" x1=\"100%\" y1=\"0%\" x2=\"0%\" y2=\"100%\">\n          <stop offset=\"0%\" stop-color=\"#c9a84c\" stop-opacity=\"0.6\"/>\n          <stop offset=\"100%\" stop-color=\"#a07830\" stop-opacity=\"0.3\"/>\n        </linearGradient>\n      </defs>\n      <circle cx=\"50\" cy=\"52\" r=\"34\" fill=\"none\" stroke=\"url(#goldD1)\" stroke-width=\"3.5\"/>\n      <circle cx=\"90\" cy=\"52\" r=\"34\" fill=\"none\" stroke=\"url(#goldD2)\" stroke-width=\"3.5\"/>\n      <path d=\"M 75 24 A 34 34 0 0 1 75 80\" fill=\"none\" stroke=\"url(#goldD2)\" stroke-width=\"3.5\"/>\n      <rect x=\"42\" y=\"12\" width=\"14\" height=\"14\" rx=\"1.5\" fill=\"none\" stroke=\"#c0c0c0\" stroke-width=\"2\" opacity=\"0.5\" transform=\"rotate(45 49 19)\"/>\n    </svg>\n  </div>\n\n  <!-- MOBILE INTRO OVERLAY -->\n  <div id=\"mobileIntro\" style=\"display:none;position:fixed;inset:0;z-index:99999;background:transparent;pointer-events:none;align-items:center;justify-content:center;\">\n    <img src=\"/assets/utsah-logo.png\" alt=\"Utsah Events\" id=\"introLogo\"\n      style=\"position:absolute;left:50%;top:50%;width:220px;opacity:0;transform:translate(-50%,-50%) scale(0.2);transition:none;object-fit:contain;will-change:transform,opacity;filter:drop-shadow(0 0 24px rgba(0,0,0,0.9)) drop-shadow(0 0 8px rgba(0,0,0,1));\">\n  </div>\n\n  <!-- NAV -->\n  <nav class=\"nav\" id=\"nav\" aria-label=\"Main navigation\">\n    <a href=\"/\" class=\"nav__logo\">\n      <img src=\"/assets/utsah-logo.png\" alt=\"Utsah Events\" class=\"nav__logo-img\">\n    </a>\n  </nav>\n\n  <!-- HAMBURGER MENU — fixed independently, never hidden by nav fade -->\n  <div class=\"nav__right\" id=\"navRight\">\n    <div id=\"navBackdrop\" class=\"nav__backdrop\"></div><div class=\"nav__dropdown\" id=\"navDropdown\">\n      <button class=\"nav__dropdown-btn\" id=\"dropdownBtn\" aria-label=\"Menu\" aria-expanded=\"false\">\n        <span></span><span></span><span></span>\n      </button>\n      <div class=\"nav__dropdown-menu\" id=\"dropdownMenu\">\n        <button class=\"menu-close-btn\" id=\"menuCloseBtn\" aria-label=\"Close menu\">&#x2715;</button>\n        <a href=\"/\"><img loading=\"lazy\" decoding=\"async\" src=\"/assets/utsah-logo.png\" alt=\"Utsah Events\" class=\"menu-logo\"></a>\n        <div class=\"menu-divider\"></div>\n        <a href=\"/about\">About Us</a>\n        <a href=\"/contact\">Contact Us</a>\n        <a href=\"/events\">Events</a>\n        <a href=\"/socials\">Socials</a>\n        <a href=\"/team\">Our Team</a>\n      </div>\n    </div>\n  </div>\n\n\n  <!-- HERO — headline lives inside the spacer so it scrolls away naturally -->\n  <div class=\"hero-spacer\" id=\"main\">\n    <div class=\"hero-headline-block\" id=\"heroHeadline\">\n      <h2 class=\"hero-headline-main\">Let's Create Magical<br>Memories Together<span class=\"accent\">.</span></h2>\n      <p class=\"hero-headline-sub\">Premium event planning · Bardoli, Gujarat</p>\n      <p class=\"hero-tagline\">Let us do everything for the future.</p>\n      <div class=\"hero-tagline-line\"></div>\n      <div class=\"hero-scroll-hint\">\n        <div class=\"hero-scroll-hint__line\"></div>\n        <span class=\"hero-scroll-hint__label\">Scroll</span>\n      </div>\n    </div>\n  </div>\n\n  <!-- UPCOMING EVENT BAR -->\n  <div class=\"upcoming-bar\" id=\"upcomingBar\">\n    <div class=\"upcoming-bar__pill\" id=\"upcomingTrigger\">\n      <span class=\"upcoming-bar__live\">UPCOMING</span>\n      <span class=\"upcoming-bar__name\">Grand Wedding Celebration</span>\n      <span class=\"upcoming-bar__sep\">·</span>\n      <span class=\"upcoming-bar__date\">15 July 2026</span>\n      <span class=\"upcoming-bar__arrow\">↗</span>\n    </div>\n  </div>\n\n  <!-- UPCOMING EVENT POPUP -->\n  <div class=\"upcoming-popup-overlay\" id=\"upcomingPopup\">\n    <div class=\"upcoming-popup\">\n      <button class=\"upcoming-popup__close\" id=\"upcomingClose\">×</button>\n      <p class=\"upcoming-popup__tag\">Upcoming Event</p>\n      <h3 class=\"upcoming-popup__title\">Grand Wedding Celebration</h3>\n      <div class=\"upcoming-popup__divider\"></div>\n      <div class=\"upcoming-popup__details\">\n        <div class=\"upcoming-popup__row\">\n          <span class=\"upcoming-popup__icon\">📅</span>\n          <span>15 July 2026, 7:00 PM onwards</span>\n        </div>\n        <div class=\"upcoming-popup__row\">\n          <span class=\"upcoming-popup__icon\">📍</span>\n          <span>Venue Name, Bardoli, Gujarat</span>\n        </div>\n      </div>\n      <div style=\"display:flex;gap:10px;justify-content:center;align-items:center;flex-wrap:nowrap;\">\n        <a href=\"https://maps.google.com/?q=Bardoli,Gujarat\" target=\"_blank\" rel=\"noopener\" class=\"upcoming-popup__btn\">View Location →</a>\n        <a href=\"https://www.instagram.com/utsahevents/\" target=\"_blank\" rel=\"noopener\" class=\"upcoming-popup__btn upcoming-popup__btn--instagram\">Instagram →</a>\n      </div>\n    </div>\n  </div>\n\n  <!-- STATS -->\n  <!-- COMBINED STATS + ABOUT -->\n  <section class=\"stats-about-combined\" id=\"about\">\n    <div class=\"stats__grid container\">\n      <div class=\"stat-block\">\n        <span class=\"stat-block__number\" data-target=\"50000\" data-suffix=\"+\">0</span>\n        <p class=\"stat-block__label\">Happy Guests</p>\n      </div>\n      <div class=\"stat-block\">\n        <span class=\"stat-block__number\" data-target=\"150\" data-suffix=\"+\">0</span>\n        <p class=\"stat-block__label\">Weddings</p>\n      </div>\n      <div class=\"stat-block\">\n        <span class=\"stat-block__number\" data-target=\"15\" data-suffix=\"+\">0</span>\n        <p class=\"stat-block__label\">Corporate Events</p>\n      </div>\n      <div class=\"stat-block\">\n        <span class=\"stat-block__number\" data-target=\"10\" data-suffix=\"+\">0</span>\n        <p class=\"stat-block__label\">Birthdays & Showers</p>\n      </div>\n    </div>\n    <div class=\"about__box\" id=\"aboutBox\">\n      <!-- Step 1: Title centered -->\n      <div class=\"about__step about__step--title\" id=\"aboutTitle\">\n        <p class=\"about__label\">Who We Are</p>\n      </div>\n      <!-- Step 2: Description -->\n      <div class=\"about__step about__step--desc\" id=\"aboutDesc\">\n        <div class=\"lang-rotate\" id=\"aboutDescRotate\">\n          <p class=\"about__text lang-slide active\">UTSAH is a comprehensive planning and coordination service provider specializing in customized events and weddings. Based in Bardoli, Gujarat, we design, plan, and manage projects from conception to execution.</p>\n          <p class=\"about__text lang-slide\">UTSAH એ કસ્ટમાઇઝ્ડ ઈવેન્ટ્સ અને વેડિંગ્સમાં નિષ્ણાત, સંપૂર્ण ઇવેન્ટ પ્લાનિંગ અને કોઓર્ડિનેશન સેવા પ્રદાતા છે. બારડોલી, ગુજરાત થી, અમે ઈવેન્ટ ડિઝાઇન, પ્લાન અને એક્ઝિક્યૂટ કરીએ છીએ.</p>\n          <p class=\"about__text lang-slide\">UTSAH एक व्यापक योजना और समन्वय सेवा प्रदाता है जो कस्टमाइज़ड इवेंट्स और शादियों में विशेषज्ञ है। बारडोली, गुजरात से, हम इवेंट डिज़ाइन, प्लान और एक्ज़ीक्यूट करते हैं।</p>\n        </div>\n      </div>\n      <!-- Step 3: Pills -->\n      <div class=\"about__step about__step--pills\" id=\"aboutPills\">\n        <span class=\"pill\">Premium Event Experiences</span>\n        <span class=\"pill\">Skilled & Passionate Team</span>\n        <span class=\"pill\">Client-First Approach</span>\n        <span class=\"pill\">Stress-Free Planning</span>\n      </div>\n\n    </div>\n  </section>\n\n  <!-- FULLSCREEN GALLERY SECTION -->\n  <section class=\"fs-gallery\" id=\"fsGallery\">\n    <div class=\"fs-gallery__sticky\">\n      <div class=\"fs-gallery__slide\" id=\"fsSlide\">\n        <div id=\"fsPhotoA\" style=\"position:absolute;inset:0;background-size:cover;background-position:center;transition:opacity 0.7s ease;\"></div>\n        <div id=\"fsPhotoB\" style=\"position:absolute;inset:0;background-size:cover;background-position:center;transition:opacity 0.7s ease;opacity:0;\"></div>\n      </div>\n    </div>\n  </section>\n\n  <!-- GOOGLE REVIEWS — live from Google Places API -->\n  <section class=\"reviews\" aria-label=\"Google Reviews\">\n    <div class=\"container\">\n      <p class=\"section-label section-label--center section-label--light\">Google Reviews</p>\n      <h2 class=\"heading-lg heading-lg--center\">WHAT CLIENTS SAY<span class=\"accent\">.</span></h2>\n      <div class=\"reviews__summary\" id=\"reviewsSummary\"></div>\n    </div>\n    <div class=\"reviews__track\" id=\"reviewsTrack\">\n      <p class=\"reviews__loading\">Loading Google reviews...</p>\n    </div>\n  </section>\n  <!-- CTA -->\n  <section class=\"cta\" id=\"contact\">\n    <div class=\"container\">\n      <p class=\"cta__sub\">Let's become family together for the future.</p>\n      <div class=\"cta__columns\">\n        <div class=\"cta__col\">\n          <a href=\"tel:+918200395197\" class=\"btn btn--primary\">Call Us</a>\n        </div>\n        <div class=\"cta__col\">\n          <a href=\"mailto:sales@utsahevents.com\" class=\"btn btn--primary\">Email Us</a>\n        </div>\n        <div class=\"cta__col\">\n          <a href=\"https://api.whatsapp.com/send/?phone=918200395197\" class=\"btn btn--primary\" target=\"_blank\" rel=\"noopener\">WhatsApp Us</a>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  <!-- FOOTER -->\n  <footer class=\"footer-min\">\n    <nav class=\"footer-min__nav\">\n      <a href=\"/\">Home</a>\n      <a href=\"/about\">About Us</a>\n      <a href=\"/events\">Events</a>\n      <a href=\"/team\">Our Team</a>\n      <a href=\"/socials\">Socials</a>\n      <a href=\"/contact\">Contact Us</a>\n    </nav>\n\n    <div class=\"footer-min__social\">\n      <a href=\"https://www.instagram.com/utsahevents/\" target=\"_blank\" rel=\"noopener\" aria-label=\"Instagram\">\n        <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><rect x=\"2\" y=\"2\" width=\"20\" height=\"20\" rx=\"5\"/><circle cx=\"12\" cy=\"12\" r=\"4\"/><circle cx=\"17.5\" cy=\"6.5\" r=\"1\"/></svg>\n      </a>\n      <a href=\"https://www.youtube.com/channel/UCCXbVgkD-0XRmWPm9OQuwHw\" target=\"_blank\" rel=\"noopener\" aria-label=\"YouTube\">\n        <svg viewBox=\"0 0 24 24\" fill=\"currentColor\"><path d=\"M23.5 6.2a3 3 0 0 0-2.1-2.1C19.5 3.5 12 3.5 12 3.5s-7.5 0-9.4.6A3 3 0 0 0 .5 6.2 31 31 0 0 0 0 12a31 31 0 0 0 .5 5.8 3 3 0 0 0 2.1 2.1c1.9.6 9.4.6 9.4.6s7.5 0 9.4-.6a3 3 0 0 0 2.1-2.1A31 31 0 0 0 24 12a31 31 0 0 0-.5-5.8ZM9.6 15.5V8.5L15.8 12Z\"/></svg>\n      </a>\n      <a href=\"https://api.whatsapp.com/send/?phone=918200395197\" target=\"_blank\" rel=\"noopener\" aria-label=\"WhatsApp\">\n        <svg viewBox=\"0 0 24 24\" fill=\"currentColor\"><path d=\"M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347M12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893A11.821 11.821 0 0 0 12.05 0\"/></svg>\n      </a>\n    </div>\n\n    <div class=\"footer-min__brand\">\n      <a href=\"/\" aria-label=\"Utsah Events home\">\n        <img src=\"/assets/utsah-logo.png\" alt=\"Utsah Events\" class=\"footer-min__logo\">\n      </a>\n    </div>\n\n    <p class=\"footer-min__copyright\">&copy; 2026 Utsah Events. All rights reserved. · <a href=\"/privacy\">Privacy Policy</a> · <a href=\"/terms\">Terms &amp; Conditions</a></p>\n  </footer>\n\n  \n  \n\n","scripts":[{"code":"document.documentElement.classList.add('js');"},{"src":"/transitions.js"},{"src":"/script.js?v=5"},{"code":"\n    // Footer Navigate → open hamburger menu\n    (function() {\n      var btn = document.getElementById('footerNavBtn');\n      if (!btn) return;\n      btn.addEventListener('click', function(e) {\n        e.preventDefault();\n        var dropMenu = document.getElementById('dropdownMenu');\n        var backdrop = document.getElementById('navBackdrop');\n        var dropBtn  = document.getElementById('dropdownBtn');\n        if (!dropMenu) return;\n        dropBtn.style.display = 'none';\n        dropMenu.classList.add('open');\n        if (backdrop) backdrop.classList.add('open');\n        document.body.style.overflow = 'hidden';\n        window.scrollTo({ top: 0, behavior: 'smooth' });\n      });\n    })();\n\n    // Fade out upcoming bar near footer\n    (function() {\n      const bar = document.getElementById('upcomingBar');\n      const footer = document.querySelector('.footer-min');\n      if (!bar || !footer) return;\n      let footerFadeTicking = false;\n      window.addEventListener('scroll', () => {\n        if (footerFadeTicking) return;\n        footerFadeTicking = true;\n        requestAnimationFrame(() => {\n          const footerTop = footer.getBoundingClientRect().top;\n          const fadeStart = window.innerHeight;\n          const fadeEnd = window.innerHeight * 0.6;\n          const opacity = Math.min(1, Math.max(0, (footerTop - fadeEnd) / (fadeStart - fadeEnd)));\n          bar.style.opacity = bar.classList.contains('visible') ? opacity : 0;\n          footerFadeTicking = false;\n        });\n      }, { passive: true });\n    })();\n\n    const upcomingPopup = document.getElementById('upcomingPopup');\n    document.getElementById('upcomingTrigger').addEventListener('click', () => {\n      upcomingPopup.classList.add('open');\n      document.body.style.overflow = 'hidden';\n    });\n    document.getElementById('upcomingClose').addEventListener('click', () => {\n      upcomingPopup.classList.remove('open');\n      document.body.style.overflow = '';\n    });\n    upcomingPopup.addEventListener('click', e => {\n      if (e.target === upcomingPopup) { upcomingPopup.classList.remove('open'); document.body.style.overflow = ''; }\n    });\n    document.addEventListener('keydown', e => {\n      if (e.key === 'Escape' && upcomingPopup.classList.contains('open')) { upcomingPopup.classList.remove('open'); document.body.style.overflow = ''; }\n    });\n\n  "}]}