px;opacity:0;transform:translate(-50%,-50%) scale(0.2);transition:none;object-fit:contain;will-change:transform,opacity;filter:drop-shadow(0 0 24px rgba(0,0,0,0.9)) drop-shadow(0 0 8px rgba(0,0,0,1));\">\n  </div>\n\n  <!-- NAV -->\n  <nav class=\"nav\" id=\"nav\" aria-label=\"Main navigation\">\n    <a href=\"/\" class=\"nav__logo\">\n      <img src=\"/assets/utsah-logo.png\" alt=\"Utsah Events\" class=\"nav__logo-img done\">\n    </a>\n  </nav>\n\n  <!-- HAMBURGER MENU — fixed independently, never hidden by nav fade -->\n  <div class=\"nav__right show\" id=\"navRight\">\n    <div id=\"navBackdrop\" class=\"nav__backdrop\"></div><div class=\"nav__dropdown\" id=\"navDropdown\">\n      <button class=\"nav__dropdown-btn\" id=\"dropdownBtn\" aria-label=\"Menu\" aria-expanded=\"false\">\n        <span></span><span></span><span></span>\n      </button>\n      <div class=\"nav__dropdown-menu\" id=\"dropdownMenu\">\n        <button class=\"menu-close-btn\" id=\"menuCloseBtn\" aria-label=\"Close menu\">✕</button>\n        <a href=\"/\"><img loading=\"lazy\" decoding=\"async\" src=\"/assets/utsah-logo.png\" alt=\"Utsah Events\" class=\"menu-logo\"></a>\n        <div class=\"menu-divider\"></div>\n        <a href=\"/about\">About Us</a>\n        <a href=\"/contact\">Contact Us</a>\n        <a href=\"/events\">Events</a>\n        <a href=\"/socials\">Socials</a>\n        <a href=\"/team\">Our Team</a>\n      </div>\n    </div>\n  </div>\n\n\n  <!-- HERO — headline lives inside the spacer so it scrolls away naturally -->\n  <div class=\"hero-spacer\" id=\"main\">\n    <div class=\"hero-headline-block\" id=\"heroHeadline\">\n      <h2 class=\"hero-headline-main\">Let's Create<br class=\"hero-break-mobile\"> Magical<br class=\"hero-break-desktop\"> Memories Together<span class=\"accent\">.</span></h2>\n      <p class=\"hero-location\">For our future family</p>\n      <div class=\"hero-location-divider\"></div>\n      <p class=\"hero-headline-sub\">Premium event planning · Bardoli, Gujarat</p>\n      <div class=\"hero-scroll-hint\">\n        <div class=\"hero-scroll-hint__ring\"></div>\n        <span class=\"hero-scroll-hint__label\">Scroll</span>\n      </div>\n    </div>\n  </div>\n\n  <!-- UPCOMING EVENT BAR -->\n  <div class=\"upcoming-bar visible\" id=\"upcomingBar\" style=\"opacity: 0; pointer-events: none;\">\n    <div class=\"upcoming-bar__pill\" id=\"upcomingTrigger\">\n      <span class=\"upcoming-bar__live\">UPCOMING</span>\n      <span class=\"upcoming-bar__name\">Grand Wedding Celebration</span>\n      <span class=\"upcoming-bar__sep\">·</span>\n      <span class=\"upcoming-bar__date\">15 July 2026</span>\n      <span class=\"upcoming-bar__arrow\">↗</span>\n    </div>\n  </div>\n\n  <!-- UPCOMING EVENT POPUP -->\n  <div class=\"upcoming-popup-overlay\" id=\"upcomingPopup\">\n    <div class=\"upcoming-popup\">\n      <button class=\"upcoming-popup__close\" id=\"upcomingClose\">×</button>\n      <p class=\"upcoming-popup__tag\">Upcoming Event</p>\n      <h3 class=\"upcoming-popup__title\">Grand Wedding Celebration</h3>\n      <div class=\"upcoming-popup__divider\"></div>\n      <div class=\"upcoming-popup__details\">\n        <div class=\"upcoming-popup__row\">\n          <span class=\"upcoming-popup__icon\">📅</span>\n          <span>15 July 2026, 7:00 PM onwards</span>\n        </div>\n        <div class=\"upcoming-popup__row\">\n          <span class=\"upcoming-popup__icon\">📍</span>\n          <span>Venue Name, Bardoli, Gujarat</span>\n        </div>\n      </div>\n      <div style=\"display:flex;gap:10px;justify-content:center;align-items:center;flex-wrap:nowrap;\">\n        <a href=\"https://maps.google.com/?q=Bardoli,Gujarat\" target=\"_blank\" rel=\"noopener\" class=\"upcoming-popup__btn\">View Location</a>\n        <a href=\"https://www.instagram.com/utsahevents/\" target=\"_blank\" rel=\"noopener\" class=\"upcoming-popup__btn upcoming-popup__btn--instagram\">Instagram</a>\n      </div>\n    </div>\n  </div>\n\n  <!-- STATS -->\n  <!-- COMBINED STATS + ABOUT -->\n  <section class=\"stats-about-combined\" id=\"about\">\n    <div class=\"stats__grid container\">\n      <div class=\"stat-block\">\n        <span class=\"stat-block__number\" data-target=\"50000\" data-suffix=\"+\">50k+</span>\n        <p class=\"stat-block__label\">Happy Guests</p>\n      </div>\n      <div class=\"stat-block\">\n        <span class=\"stat-block__number\" data-target=\"150\" data-suffix=\"+\">150+</span>\n        <p class=\"stat-block__label\">Weddings</p>\n      </div>\n      <div class=\"stat-block\">\n        <span class=\"stat-block__number\" data-target=\"15\" data-suffix=\"+\">15+</span>\n        <p class=\"stat-block__label\">Corporate Events</p>\n      </div>\n      <div class=\"stat-block\">\n        <span class=\"stat-block__number\" data-target=\"10\" data-suffix=\"+\">10+</span>\n        <p class=\"stat-block__label\">Birthdays &amp; Showers</p>\n      </div>\n    </div>\n    <div class=\"about__box\" id=\"aboutBox\">\n      <!-- Step 1: Title centered -->\n      <div class=\"about__step about__step--title show\" id=\"aboutTitle\">\n        <p class=\"about__label\">Who We Are</p>\n      </div>\n      <!-- Step 2: Description -->\n      <div class=\"about__step about__step--desc show\" id=\"aboutDesc\">\n        <div class=\"lang-rotate\" id=\"aboutDescRotate\">\n          <p class=\"about__text lang-slide\">UTSAH is a comprehensive planning and coordination service provider specializing in customized events and weddings. Based in Bardoli, Gujarat, we design, plan, and manage projects from conception to execution.</p>\n          <p class=\"about__text lang-slide\">UTSAH એ કસ્ટમાઇઝ્ડ ઈવેન્ટ્સ અને વેડિંગ્સમાં નિષ્ણાત, સંપૂર્ण ઇવેન્ટ પ્લાનિંગ અને કોઓર્ડિનેશન સેવા પ્રદાતા છે. બારડોલી, ગુજરાત થી, અમે ઈવેન્ટ ડિઝાઇન, પ્લાન અને એક્ઝિક્યૂટ કરીએ છીએ.</p>\n          <p class=\"about__text lang-slide active\">UTSAH एक व्यापक योजना और समन्वय सेवा प्रदाता है जो कस्टमाइज़ड इवेंट्स और शादियों में विशेषज्ञ है। बारडोली, गुजरात से, हम इवेंट डिज़ाइन, प्लान और एक्ज़ीक्यूट करते हैं।</p>\n        </div>\n      </div>\n      <!-- Step 3: Pills -->\n      <div class=\"about__step about__step--pills show\" id=\"aboutPills\">\n        <a href=\"/events\" class=\"pill\">Premium Event Experiences</a>\n        <a href=\"/events\" class=\"pill\">Client-First Approach</a>\n      </div>\n\n    </div>\n  </section>\n\n  <!-- FULLSCREEN GALLERY SECTION -->\n  <section class=\"fs-gallery\" id=\"fsGallery\">\n    <div class=\"fs-gallery__sticky\">\n      <div class=\"fs-gallery__slide\" id=\"fsSlide\">\n        <div id=\"fsPhotoA\"></div>\n        <div id=\"fsPhotoB\"></div>\n      </div>\n    </div>\n  </section>\n\n  <!-- GOOGLE REVIEWS — live from Google Places API -->\n  <section class=\"reviews\" aria-label=\"Google Reviews\">\n    <div class=\"container\">\n      <p class=\"section-label section-label--center section-label--light reveal visible\">Google Reviews</p>\n      <h2 class=\"heading-lg heading-lg--center reveal visible\">WHAT CLIENTS SAY<span class=\"accent\">.</span></h2>\n      <div class=\"reviews__summary\" id=\"reviewsSummary\">\n        <p class=\"reviews__summary-rating\">5.0</p>\n        <p class=\"reviews__summary-stars\">★★★★★</p>\n        <p class=\"reviews__summary-count\">69 reviews on Google</p>\n        <p class=\"reviews__summary-badge\">\n          <svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\"><path d=\"M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92a5.06 5.06 0 01-2.2 3.32v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.1z\" fill=\"#4285F4\"></path><path d=\"M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z\" fill=\"#34A853\"></path><path d=\"M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z\" fill=\"#FBBC05\"></path><path d=\"M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 