  "scripts": [
    {
      "code": "document.documentElement.classList.add('js');"
    },
    {
      "src": "/transitions.js"
    },
    {
      "src": "/script.js?v=5"
    },
    {
      "code": "\n    // Hero scroll hint — hide once the page scrolls, reappear back at the hero\n    (function() {\n      var hint = document.querySelector('.hero-scroll-hint');\n      if (!hint) return;\n      var onScroll = function() {\n        hint.style.opacity = window.scrollY > 40 ? '0' : '';\n      };\n      window.addEventListener('scroll', onScroll, { passive: true });\n      onScroll();\n    })();\n\n    // Footer Navigate → open hamburger menu\n    (function() {\n      var btn = document.getElementById('footerNavBtn');\n      if (!btn) return;\n      btn.addEventListener('click', function(e) {\n        e.preventDefault();\n        var dropMenu = document.getElementById('dropdownMenu');\n        var backdrop = document.getElementById('navBackdrop');\n        var dropBtn  = document.getElementById('dropdownBtn');\n        if (!dropMenu) return;\n        dropBtn.style.display = 'none';\n        dropMenu.classList.add('open');\n        if (backdrop) backdrop.classList.add('open');\n        document.body.style.overflow = 'hidden';\n        window.scrollTo({ top: 0, behavior: 'smooth' });\n      });\n    })();\n\n    // Fade out upcoming bar near footer\n    (function() {\n      const bar = document.getElementById('upcomingBar');\n      const footer = document.querySelector('.footer-min');\n      if (!bar || !footer) return;\n      let footerFadeTicking = false;\n      window.addEventListener('scroll', () => {\n        if (footerFadeTicking) return;\n        footerFadeTicking = true;\n        requestAnimationFrame(() => {\n          const footerTop = footer.getBoundingClientRect().top;\n          const fadeStart = window.innerHeight;\n          const fadeEnd = window.innerHeight * 0.6;\n          const opacity = Math.min(1, Math.max(0, (footerTop - fadeEnd) / (fadeStart - fadeEnd)));\n          const isVisible = bar.classList.contains('visible');\n          bar.style.opacity = isVisible ? opacity : 0;\n          bar.style.pointerEvents = (isVisible && opacity > 0.05) ? 'auto' : 'none';\n          footerFadeTicking = false;\n        });\n      }, { passive: true });\n    })();\n\n    const upcomingPopup = document.getElementById('upcomingPopup');\n    document.getElementById('upcomingTrigger').addEventListener('click', () => {\n      upcomingPopup.classList.add('open');\n      document.body.style.overflow = 'hidden';\n    });\n    document.getElementById('upcomingClose').addEventListener('click', () => {\n      upcomingPopup.classList.remove('open');\n      document.body.style.overflow = '';\n    });\n    upcomingPopup.addEventListener('click', e => {\n      if (e.target === upcomingPopup) { upcomingPopup.classList.remove('open'); document.body.style.overflow = ''; }\n    });\n    document.addEventListener('keydown', e => {\n      if (e.key === 'Escape' && upcomingPopup.classList.contains('open')) { upcomingPopup.classList.remove('open'); document.body.style.overflow = ''; }\n    });\n\n  "
    }
  ]
